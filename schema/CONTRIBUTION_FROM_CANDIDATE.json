{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/fecgov/fecfile-validate/blob/main/schema/CONTRIBUTION_FROM_CANDIDATE.json",
    "version": "v0.0.0.0",
    "title": "FEC Contribution from Candidate",
    "description": "Contribution from Candidate (11d)",
    "type": "object",
    "required": [
        "form_type",
        "filer_committee_id_number",
        "transaction_type_identifier",
        "transaction_id",
        "entity_type",
        "contributor_organization_name",
        "contributor_street_1",
        "contributor_city",
        "contributor_state",
        "contributor_zip",
        "contribution_date",
        "contribution_amount",
        "contribution_aggregate",
        "aggregation_group",
        "donor_committee_fec_id",
        "donor_committee_name"
    ],
    "fec_recommended": [],
    "properties": {
        "report_type": {"type": "string", "maxLength": 5},
        "form_type": {"const": "SA11D"},
        "filer_committee_id_number": {
            "type": "string",
            "minLength": 9,
            "maxLength": 9,
            "pattern": "^(?:[PC][0-9]{8}|[HS][0-9]{1}[A-Z]{2}[0-9]{5})$"
        },
        "transaction_type_identifier": {"const": "CONTRIBUTION_FROM_CANDIDATE"},
        "transaction_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[ -~]{0,20}$"
        },
        "entity_type": {"const": "COM"},
        "contributor_organization_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[ -~]{0,200}$"
        },
        "contributor_street_1": {
            "type": "string",
            "minLength": 1,
            "maxLength": 34,
            "pattern": "^[ -~]{0,34}$"
        },
        "contributor_city": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[ -~]{0,30}$"
        },
        "contributor_state": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2,
            "pattern": "^[ -~]{0,2}$"
        },
        "contributor_zip": {
            "type": "string",
            "minLength": 1,
            "maxLength": 9,
            "pattern": "^[ -~]{0,9}$"
        },
        "election_code": {
            "type": ["string", "null"],
            "minLength": 1,
            "maxLength": 5,
            "pattern": "^[GPRSCEO]\\d{4}$"
        },
        "election_other_description": {
            "type": ["string", "null"],
            "minLength": 0,
            "maxLength": 20,
            "pattern": "^[ -~]{0,20}$"
        },
        "contribution_date": {
            "type": "string",
            "minLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "contribution_amount": {
            "type": "number",
            "minimum": -99999999.99,
            "maximum": 999999999.99
        },
        "contribution_aggregate": {
            "type": "number",
            "minimum": -99999999.99,
            "maximum": 999999999.99
        },
        "aggregation_group": {"const": "GENERAL"},
        "contribution_purpose_descrip": {
            "type": ["string", "null"],
            "maxLength": 100,
            "pattern": "^[ -~]{0,100}$"
        },
        "donor_committee_fec_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 9,
            "pattern": "^(?:[PC][0-9]{8}|[HS][0-9]{1}[A-Z]{2}[0-9]{5})$"
        },
        "donor_committee_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[ -~]{0,200}$"
        },
        "memo_code": {"type": ["boolean", "null"]},
        "memo_text_description": {
            "type": ["string", "null"],
            "maxLength": 100,
            "pattern": "^[ -~]{0,100}$"
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {"report_type": {"const": "F3"}},
                "required": ["report_type"]
            },
            "then": {
                "required": ["election_code"],
                "properties": {"election_code": {"type": "string"}}
            }
        },
        {
            "if": {
                "properties": {
                    "election_code": {
                        "pattern": "^O\\d{4}$",
                        "type": "string"
                    }
                },
                "required": ["election_code"]
            },
            "then": {
                "required": ["election_other_description"],
                "properties": {"election_other_description": {"type": "string"}}
            }
        }
    ]
}