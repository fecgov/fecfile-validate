{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/fecgov/fecfile-validate/blob/main/schema/AUTHORIZED_COMMITTEE_TRANSFER.json",
  "version": "v0.0.0.0",
  "title": "FEC Authorized Committee Transfer",
  "description": "Authorized Committee Transfer (SA12/SA18)",
  "type": "object",
  "required": [
    "form_type",
    "filer_committee_id_number",
    "transaction_type_identifier",
    "transaction_id",
    "entity_type",
    "contributor_organization_name",
    "contributor_street_1",
    "contributor_city",
    "contributor_state",
    "contributor_zip",
    "election_code",
    "contribution_date",
    "contribution_amount",
    "aggregation_group",
    "contribution_purpose_descrip",
    "donor_committee_fec_id",
    "donor_committee_name",
    "donor_candidate_fec_id",
    "donor_candidate_last_name",
    "donor_candidate_first_name",
    "donor_candidate_office"
  ],
  "fec_recommended": [],
  "properties": {
    "form_type": {
      "enum": ["SA12", "SA18"],
      "examples": ["SA12"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "FORM TYPE",
        "TYPE": "A/N-8",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "SA12",
        "VALUE_REFERENCE": "[SA12 | SA18]",
        "RULE_REFERENCE": "If Report Type is F3 then SA12\nIf Report Type is F3P then SA18",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "report_type": {
      "type": "string",
      "maxLength": 5,
      "examples": ["F3"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "REPORT TYPE",
        "TYPE": "A/N-100",
        "REQUIRED": null,
        "SAMPLE_DATA": "F3",
        "VALUE_REFERENCE": "[F3 | F3P]",
        "RULE_REFERENCE": "F3 | F3P",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "filer_committee_id_number": {
      "type": "string",
      "minLength": 9,
      "maxLength": 9,
      "pattern": "^(?:[PC][0-9]{8}|[HS][0-9]{1}[A-Z]{2}[0-9]{5})$",
      "examples": ["C00123456"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "FILER COMMITTEE ID NUMBER",
        "TYPE": "A/N-9",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "C00123456",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "transaction_type_identifier": {
      "const": "AUTHORIZED_COMMITTEE_TRANSFER",
      "examples": ["AUTHORIZED_COMMITTEE_TRANSFER"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "TRANSACTION TYPE IDENTIFIER",
        "TYPE": null,
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": "AUTHORIZED_COMMITTEE_TRANSFER",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "transaction_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[ -~]{0,20}$",
      "examples": ["A56123456789-1234"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "TRANSACTION ID",
        "TYPE": "A/N-20",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "A56123456789-1234",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": "Must be unique for the life of a report (original + amendments) within each committee account. Letters, if included, must be uppercase.",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "entity_type": {
      "const": "COM",
      "examples": ["COM"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "ENTITY TYPE",
        "TYPE": "A/N-3",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "COM",
        "VALUE_REFERENCE": "COM",
        "RULE_REFERENCE": "COM Only",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contributor_organization_name": {
      "title": "CONTRIBUTOR ORGANIZATION NAME",
      "description": "",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[ -~]{0,200}$",
      "examples": ["Jo Smith & Co."],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTOR ORGANIZATION NAME",
        "TYPE": "A/N-200",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "Jo Smith & Co.",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contributor_street_1": {
      "type": "string",
      "minLength": 1,
      "maxLength": 34,
      "pattern": "^[ -~]{0,34}$",
      "examples": ["123 Main Street"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTOR STREET 1",
        "TYPE": "A/N-34",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "123 Main Street",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contributor_city": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[ -~]{0,30}$",
      "examples": ["Anytown"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTOR CITY",
        "TYPE": "A/N-30",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "Anytown",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contributor_state": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2,
      "pattern": "^[ -~]{0,2}$",
      "examples": ["VA"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTOR STATE",
        "TYPE": "A/N-2",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "VA",
        "VALUE_REFERENCE": "AK,AL,...",
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contributor_zip": {
      "type": "string",
      "minLength": 1,
      "maxLength": 9,
      "pattern": "^[ -~]{0,9}$",
      "examples": ["22314"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTOR ZIP",
        "TYPE": "A/N-9",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "22314",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "election_code": {
      "title": "ELECTION CODE",
      "description": "",
      "type": "string",
      "minLength": 1,
      "maxLength": 5,
      "pattern": "^[GPRSCEO]\\d{4}$",
      "examples": ["P2012"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "ELECTION CODE",
        "TYPE": "A/N-5",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "P2012",
        "VALUE_REFERENCE": "G,P,O[YYYY]",
        "RULE_REFERENCE": "Values: [G|P|R|S|C|E|O]+Year{YYYY}",
        "FIELD_FORM_ASSOCIATION": "F3 | F3X | F3P"
      }
    },
    "election_other_description": {
      "title": "ELECTION OTHER DESCRIPTION",
      "description": "",
      "type": ["string", "null"],
      "minLength": 0,
      "maxLength": 20,
      "pattern": "^[ -~]{0,20}$",
      "fec_spec": {
        "FIELD_DESCRIPTION": "ELECTION OTHER DESCRIPTION",
        "TYPE": "A/N-20",
        "REQUIRED": "X (conditional error)",
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": "Req if Item Election Code = O",
        "FIELD_FORM_ASSOCIATION": "F3 | F3X | F3P"
      }
    },
    "contribution_date": {
      "type": "string",
      "minLength": 10,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "examples": ["2024-01-15"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTION DATE",
        "TYPE": "DATE",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "2024-01-15",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contribution_amount": {
      "type": "number",
      "minimum": -99999999.99,
      "maximum": 999999999.99,
      "examples": [1000.0],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTION AMOUNT",
        "TYPE": "NUM",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": 1000.0,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contribution_aggregate": {
      "type": "number",
      "minimum": -99999999.99,
      "maximum": 999999999.99,
      "examples": [1000.0],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTION AGGREGATE",
        "TYPE": "NUM",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": 1000.0,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": "F3 | F3P - Cycle to Date; F3X - YTD;\nF3L - Semi-annual Bundled Total",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "aggregation_group": {
      "const": "GENERAL",
      "examples": ["GENERAL"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "AGGREGATION GROUP",
        "TYPE": "A/N-7",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "GENERAL",
        "VALUE_REFERENCE": "GENERAL",
        "RULE_REFERENCE": "GENERAL Only",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "contribution_purpose_descrip": {
      "type": ["string", "null"],
      "maxLength": 100,
      "pattern": "^[ -~]{0,100}$",
      "examples": ["Transfer from Authorized Committee"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "CONTRIBUTION PURPOSE DESCRIPTION",
        "TYPE": "A/N-100",
        "REQUIRED": null,
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": "Transfer from Authorized Committee",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_committee_fec_id": {
      "title": "DONOR COMMITTEE FEC ID",
      "description": "",
      "type": "string",
      "minLength": 1,
      "maxLength": 9,
      "pattern": "^(?:[PC][0-9]{8}|[HS][0-9]{1}[A-Z]{2}[0-9]{5})$",
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR COMMITTEE FEC ID",
        "TYPE": "A/N-9",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_committee_name": {
      "title": "DONOR COMMITTEE NAME",
      "description": "",
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[ -~]{0,200}$",
      "examples": ["Action PAC"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR COMMITTEE NAME",
        "TYPE": "A/N-200",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "Action PAC",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_fec_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 9,
      "pattern": "^(?:P[0-9]{8}|[HS][0-9]{1}[A-Z]{2}[0-9]{5})$",
      "examples": ["P00123456"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE FEC ID",
        "TYPE": "A/N-9",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "P00123456",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_last_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30,
      "pattern": "^[ -~]{0,30}$",
      "examples": ["Smith"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE LAST NAME",
        "TYPE": "A/N-30",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "Smith",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_first_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[ -~]{0,20}$",
      "examples": ["John"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE FIRST NAME",
        "TYPE": "A/N-20",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "John",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_middle_name": {
      "type": ["string", "null"],
      "maxLength": 20,
      "pattern": "^[ -~]{0,20}$",
      "examples": ["W"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE MIDDLE NAME",
        "TYPE": "A/N-20",
        "REQUIRED": null,
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_prefix": {
      "type": ["string", "null"],
      "maxLength": 10,
      "pattern": "^[ -~]{0,10}$",
      "examples": ["Dr"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE PREFIX",
        "TYPE": "A/N-10",
        "REQUIRED": null,
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_suffix": {
      "type": ["string", "null"],
      "maxLength": 10,
      "pattern": "^[ -~]{0,10}$",
      "examples": ["Jr"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE SUFFIX",
        "TYPE": "A/N-10",
        "REQUIRED": null,
        "SAMPLE_DATA": null,
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_office": {
      "enum": ["H", "S", "P"],
      "examples": ["H"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE OFFICE",
        "TYPE": "A/N-1",
        "REQUIRED": "X (error)",
        "SAMPLE_DATA": "H",
        "VALUE_REFERENCE": "[H|S|P]",
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_state": {
      "type": ["string", "null"],
      "minLength": 2,
      "maxLength": 2,
      "pattern": "^[A-Z]{2}$",
      "examples": ["VA"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE STATE",
        "TYPE": "A/N-2",
        "REQUIRED": "X (conditional error)",
        "SAMPLE_DATA": "VA",
        "VALUE_REFERENCE": "AK,AL,...",
        "RULE_REFERENCE": "Req if Office = Sen or House",
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "donor_candidate_district": {
      "type": ["string", "null"],
      "minLength": 2,
      "maxLength": 2,
      "pattern": "^[0-9]{2}$",
      "examples": ["01"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "DONOR CANDIDATE DISTRICT",
        "TYPE": "NUM-2",
        "REQUIRED": "X (conditional error)",
        "SAMPLE_DATA": 1,
        "VALUE_REFERENCE": "01-99",
        "RULE_REFERENCE": "Req if Office = House",
        "FIELD_FORM_ASSOCIATION": null
      }
    },

    "memo_code": {
      "type": ["boolean", "null"],
      "examples": [true],
      "fec_spec": {
        "FIELD_DESCRIPTION": "MEMO CODE",
        "TYPE": "BOOLEAN",
        "REQUIRED": null,
        "SAMPLE_DATA": true,
        "VALUE_REFERENCE": "TRUE/FALSE",
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    },
    "memo_text_description": {
      "type": ["string", "null"],
      "maxLength": 100,
      "pattern": "^[ -~]{0,100}$",
      "examples": ["Memo"],
      "fec_spec": {
        "FIELD_DESCRIPTION": "MEMO TEXT DESCRIPTION",
        "TYPE": "A/N-100",
        "REQUIRED": null,
        "SAMPLE_DATA": "Memo",
        "VALUE_REFERENCE": null,
        "RULE_REFERENCE": null,
        "FIELD_FORM_ASSOCIATION": null
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "election_code": {
            "pattern": "^O\\d{4}$",
            "type": "string"
          }
        },
        "required": ["election_code"]
      },
      "then": {
        "required": ["election_other_description"],
        "properties": { "election_other_description": { "type": "string" } }
      }
    },
    {
      "if": {
        "properties": { "donor_candidate_office": { "const": "H" } },
        "required": ["donor_candidate_office"]
      },
      "then": {
        "required": ["donor_candidate_state", "donor_candidate_district"],
        "properties": {
          "donor_candidate_state": { "type": "string" },
          "donor_candidate_district": { "type": "string" }
        }
      }
    },
    {
      "if": {
        "properties": { "donor_candidate_office": { "const": "S" } },
        "required": ["donor_candidate_office"]
      },
      "then": {
        "required": ["donor_candidate_state"],
        "properties": { "donor_candidate_state": { "type": "string" } }
      }
    }
  ]
}
