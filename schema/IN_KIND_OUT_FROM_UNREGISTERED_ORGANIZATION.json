{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/fecgov/fecfile-validate/blob/main/schema/IN_KIND_OUT_FROM_UNREGISTERED_ORGANIZATION.json",
    "version": "v0.0.0.0",
    "title": "FEC In-Kind Out from Unregistered Organization",
    "description": "In-Kind Out from Unregistered Organization (line 17)",
    "type": "object",
    "required": [
        "form_type",
        "filer_committee_id_number",
        "transaction_type_identifier",
        "back_reference_tran_id_number",
        "back_reference_sched_name",
        "transaction_id",
        "entity_type",
        "payee_organization_name",
        "payee_street_1",
        "payee_city",
        "payee_state",
        "payee_zip",
        "expenditure_date",
        "expenditure_amount",
        "aggregate_amount",
        "aggregation_group",
        "expenditure_purpose_descrip"
    ],
    "fec_recommended": [],
    "properties": {
        "report_type": {
            "title": "REPORT TYPE",
            "description": "",
            "type": "string",
            "maxLength": 5,
            "examples": [
                "F3"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "REPORT TYPE",
                "TYPE": "A/N-100",
                "SAMPLE DATA": "F3",
                "VALUE REFERENCE": null,
                "RULE REFERENCE": null,
                "FIELD_FORM_ASSOCIATION": "F3"
            },
            "const": "F3"
        },
        "form_type": {
            "title": "FORM TYPE",
            "description": "",
            "type": "string",
            "enum": [
                "SB17"
            ],
            "examples": [
                "SB17"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "FORM TYPE",
                "TYPE": "A/N-8",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "SB17",
                "VALUE_REFERENCE": "SB17 only",
                "RULE_REFERENCE": "SB17 only"
            }
        },
        "filer_committee_id_number": {
            "title": "FILER COMMITTEE ID NUMBER",
            "description": "",
            "type": "string",
            "minLength": 9,
            "maxLength": 9,
            "pattern": "^(?:[PC][0-9]{8}|[HS][0-9]{1}[A-Z]{2}[0-9]{5})$",
            "examples": [
                "C00123456"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "FILER COMMITTEE ID NUMBER",
                "TYPE": "A/N-9",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "C00123456",
                "RULE_REFERENCE": "this is the ID of the Committee Account the report/transaction is associated with"
            }
        },
        "transaction_type_identifier": {
            "title": "TRANSACTION TYPE IDENTIFIER",
            "description": "",
            "const": "IN_KIND_OUT_FROM_UNREGISTERED_ORGANIZATION",
            "examples": [
                "IN_KIND_OUT_FROM_UNREGISTERED_ORGANIZATION"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "TRANSACTION TYPE IDENTIFIER",
                "TYPE": "A/N-12",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "IN_KIND_OUT_FROM_UNREGISTERED_ORGANIZATION"
            }
        },
        "transaction_id": {
            "title": "TRANSACTION ID",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[ -~]{0,20}$",
            "examples": [
                "A56123456789-1234"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "TRANSACTION ID",
                "TYPE": "A/N-20",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "A56123456789-1234",
                "RULE_REFERENCE": "Must be unique for the life of a report (original + amendments) within each committee account. Letters, if included, must be uppercase."
            }
        },
        "back_reference_tran_id_number": {
            "title": "BACK REFERENCE TRAN ID NUMBER",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "pattern": "^[ -~]{0,20}$",
            "examples": [
                "A123456789-1234"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "BACK REFERENCE TRAN ID NUMBER",
                "TYPE": "A/N-20",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "A123456789-1234",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Reference to the Tran ID of a Related Record",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "back_reference_sched_name": {
            "title": "BACK REFERENCE SCHED NAME",
            "description": "",
            "type": "string",
            "enum": [
                "SA11AI",
                "SA11AII"
            ],
            "examples": [
                "SA11AI",
                "SA11AII"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "BACK REFERENCE SCHED NAME",
                "TYPE": "A/N-8",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "SA11AI",
                "VALUE_REFERENCE": "SA[line# ref]",
                "RULE_REFERENCE": "Ref to the Schedule that has the Related Record.  SA3L must be used \nwith the F3L",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "entity_type": {
            "title": "ENTITY TYPE",
            "description": "",
            "const": "ORG",
            "examples": [
                "ORG"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "ENTITY TYPE",
                "TYPE": "A/N-3",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "ORG",
                "VALUE_REFERENCE": "ORG only",
                "RULE_REFERENCE": "ORG only",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "payee_street_1": {
            "title": "PAYEE STREET  1",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 34,
            "pattern": "^[ -~]{0,34}$",
            "examples": [
                "123 Main Street"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "PAYEE STREET  1",
                "TYPE": "A/N-34",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "123 Main Street",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "payee_street_2": {
            "title": "PAYEE STREET  2",
            "description": "",
            "type": [
                "string",
                "null"
            ],
            "minLength": 0,
            "maxLength": 34,
            "pattern": "^[ -~]{0,34}$",
            "fec_spec": {
                "FIELD_DESCRIPTION": "PAYEE STREET  2",
                "TYPE": "A/N-34",
                "REQUIRED": null,
                "SAMPLE_DATA": null,
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "payee_city": {
            "title": "PAYEE CITY",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "pattern": "^[ -~]{0,30}$",
            "examples": [
                "Anytown"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "PAYEE CITY",
                "TYPE": "A/N-30",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "Anytown",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "payee_state": {
            "title": "PAYEE STATE",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 2,
            "pattern": "^[ -~]{0,2}$",
            "examples": [
                "WA"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "PAYEE STATE",
                "TYPE": "A/N-2",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "AK,AL,...,ZZ",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "payee_zip": {
            "title": "PAYEE ZIP",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 9,
            "pattern": "^[ -~]{0,9}$",
            "examples": [
                981110123
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "PAYEE ZIP",
                "TYPE": "A/N-9",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": 981110123,
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "election_code": {
            "title": "ELECTION CODE",
            "description": "",
            "type": [
                "string",
                "null"
            ],
            "minLength": 1,
            "maxLength": 5,
            "pattern": "^[GPRSCEO]\\d{4}$",
            "fec_spec": {
                "FIELD_DESCRIPTION": "ELECTION CODE",
                "TYPE": "A/N-5",
                "REQUIRED": "X (error)",
                "VALUE_REFERENCE": "G,P,O[YYYY]",
                "RULE_REFERENCE": "Values: [G|P|R|S|C|E|O]+Year{YYYY}",
                "FIELD_FORM_ASSOCIATION": "F3"
            }
        },
        "election_other_description": {
            "title": "ELECTION OTHER DESCRIPTION",
            "description": "",
            "type": [
                "string",
                "null"
            ],
            "minLength": 0,
            "maxLength": 20,
            "pattern": "^[ -~]{0,20}$",
            "fec_spec": {
                "FIELD_DESCRIPTION": "ELECTION OTHER DESCRIPTION",
                "TYPE": "A/N-20",
                "REQUIRED": "X (conditional error)",
                "RULE_REFERENCE": "Req if Item Election Code = O",
                "FIELD_FORM_ASSOCIATION": "F3"
            }
        },
        "expenditure_date": {
            "title": "EXPENDITURE DATE",
            "description": "",
            "type": "string",
            "minLength": 10,
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "examples": [
                "2018-11-13"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "EXPENDITURE DATE",
                "TYPE": "NUM-8",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "YYYYMMDD",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "expenditure_amount": {
            "title": "EXPENDITURE AMOUNT",
            "description": "",
            "type": "number",
            "minimum": -99999999.99,
            "maximum": 999999999.99,
            "examples": [
                250
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "EXPENDITURE AMOUNT",
                "TYPE": "AMT-12",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": 250,
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "aggregate_amount": {
            "title": "AGGREGATE AMOUNT",
            "description": "",
            "type": "number",
            "minimum": -99999999.99,
            "maximum": 999999999.99,
            "examples": [
                1000
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "AGGREGATE AMOUNT",
                "TYPE": "AMT-12",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": 1000,
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": null,
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "aggregation_group": {
            "title": "AGGREGATION GROUP",
            "description": "",
            "const": "GENERAL_DISBURSEMENT",
            "examples": [
                "GENERAL_DISBURSEMENT"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "AGGREGATION GROUP",
                "TYPE": "A/N-100",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "GENERAL_DISBURSEMENT",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": null,
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "expenditure_purpose_descrip": {
            "title": "EXPENDITURE PURPOSE DESCRIPTION",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^In-Kind: [ -~]{1,91}$",
            "fec_spec": {
                "FIELD_DESCRIPTION": "EXPENDITURE PURPOSE DESCRIPTION",
                "TYPE": "A/N-100",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": null,
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": "Auto-generated from associated IN_KIND_RECEIPT ",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "category_code": {
            "title": "CATEGORY CODE",
            "description": "",
            "type": [
                "string",
                "null"
            ],
            "enum": [
                "001",
                "002",
                "003",
                "004",
                "005",
                "006",
                "007",
                "008",
                "009",
                "010",
                "011",
                "012",
                null
            ],
            "examples": [
                1
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "CATEGORY CODE",
                "TYPE": "A/N-3",
                "REQUIRED": null,
                "SAMPLE_DATA": 1,
                "VALUE_REFERENCE": "001-012",
                "RULE_REFERENCE": "Only codes 001-012",
                "FIELD_FORM_ASSOCIATION": "F3 | F3X | F3P"
            }
        },
        "memo_code": {
            "title": "MEMO CODE",
            "description": "",
            "type": [
                "boolean",
                "null"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "MEMO CODE",
                "TYPE": "A/N-1",
                "REQUIRED": null,
                "SAMPLE_DATA": null,
                "VALUE_REFERENCE": "X",
                "RULE_REFERENCE": "X = True",
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "memo_text_description": {
            "title": "MEMO TEXT/DESCRIPTION",
            "description": "",
            "type": [
                "string",
                "null"
            ],
            "minLength": 0,
            "maxLength": 100,
            "pattern": "^[ -~]{0,100}$",
            "fec_spec": {
                "FIELD_DESCRIPTION": "MEMO TEXT/DESCRIPTION",
                "TYPE": "A/N-100",
                "REQUIRED": null,
                "SAMPLE_DATA": null,
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": null,
                "FIELD_FORM_ASSOCIATION": null
            }
        },
        "reattribution_redesignation_tag": {
            "title": "REATTRIBUTION REDESIGNATION TAG",
            "description": "",
            "enum": [
                "REATTRIBUTED",
                "REDESIGNATED",
                "REATTRIBUTION_FROM",
                "REATTRIBUTION_TO",
                "REDESIGNATION_FROM",
                "REDESIGNATION_TO",
                null
            ],
            "examples": [
                "REATTRIBUTED"
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "REATTRIBUTION REDESIGNATION TAG",
                "TYPE": "A/N-20",
                "REQUIRED": null,
                "SAMPLE_DATA": "REATTRIBUTED",
                "VALUE_REFERENCE": null,
                "RULE_REFERENCE": null
            }
        },
        "payee_organization_name": {
            "title": "PAYEE ORGANIZATION NAME",
            "description": "",
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[ -~]{0,200}$",
            "examples": [
                "John Smith & Co."
            ],
            "fec_spec": {
                "FIELD_DESCRIPTION": "PAYEE ORGANIZATION NAME",
                "TYPE": "A/N-200",
                "REQUIRED": "X (error)",
                "SAMPLE_DATA": "John Smith & Co.",
                "RULE_REFERENCE": "Auto-generated from associated Schedule A IN_KIND receipt"
            }
        }
    },
    "allOf": [
        {
            "if": {
                "properties": {
                    "report_type": {
                        "const": "F3"
                    }
                },
                "required": [
                    "report_type"
                ]
            },
            "then": {
                "required": [
                    "form_type",
                    "election_code"
                ],
                "properties": {
                    "form_type": {
                        "const": "SB17"
                    },
                    "election_code": {
                        "type": "string"
                    }
                }
            }
        },
        {
            "if": {
                "properties": {
                    "election_code": {
                        "pattern": "^O\\d{4}$",
                        "type": "string"
                    }
                },
                "required": [
                    "election_code"
                ]
            },
            "then": {
                "required": [
                    "election_other_description"
                ],
                "properties": {
                    "election_other_description": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            }
        }
    ]
}
